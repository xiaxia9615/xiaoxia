#!/usr/bin/env bash
# pre-push: fast checks only, full tests delegated to CI
set -e

while read -r local_ref local_sha remote_ref remote_sha; do
  :
done

if git diff --cached --name-only | grep -qE "^src/.*(\.ts|\.tsx)$"; then
  echo "  - TypeScript"
  npx tsc --noEmit
fi

if git diff --cached --name-only | grep -qE "^(src/|check-architecture\.mjs)"; then
  echo "  - Architecture check"
  node check-architecture.mjs
fi

CHANGED=$(git diff --cached --name-only --diff-filter=ACM | grep -E "\.(ts|tsx|js|jsx)$" | tr "\n" " ")
if [ -n "$CHANGED" ]; then
  echo "  - ESLint"
  echo "$CHANGED" | xargs npx eslint
fi

echo "pre-push passed, full tests delegated to CI"
